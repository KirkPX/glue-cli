{
  "name": "@kirkpx/glue-cli",
  "version": "2.1.0",
  "description": "CLI for Glue (glue.co) — threads, messages, groups, reactions, real-time watch, over the GraphQL API + GetStream chat layer",
  "main": "./dist/lib.js",
  "types": "./dist/lib.d.ts",
  "bin": {
    "glue": "./dist/index.js"
  },
  "files": [
    "dist/",
    "README.md",
    "LICENSE",
    "examples/"
  ],
  "scripts": {
    "prepare": "npm run build",
    "build": "tsup src/index.ts src/lib.ts --format esm --dts --clean",
    "cli": "tsx src/index.ts",
    "test": "vitest run",
    "pretest": "npm run build",
    "typecheck": "tsc --noEmit",
    "dev": "tsx src/index.ts",
    "smoke": "node dist/index.js --help",
    "setup": "npm ci && npm link && node dist/index.js doctor --install",
    "doctor": "node dist/index.js doctor"
  },
  "keywords": [
    "glue",
    "cli",
    "chat",
    "messaging",
    "graphql",
    "getstream"
  ],
  "author": "KirkPX",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/KirkPX/glue-cli.git"
  },
  "type": "module",
  "dependencies": {
    "@apollo/client": "^4.3.6",
    "@napi-rs/keyring": "^1.3.0",
    "commander": "^14.0.3",
    "graphql": "^16.14.2",
    "picocolors": "^1.1.1",
    "stream-chat": "^9.54.4",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^20.19.43",
    "tsup": "^8.5.1",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^4.1.12"
  },
  "private": true,
  "exports": {
    ".": {
      "types": "./dist/lib.d.ts",
      "import": "./dist/lib.js"
    },
    "./package.json": "./package.json"
  },
  "engines": {
    "node": ">=20"
  },
  "bugs": {
    "url": "https://github.com/KirkPX/glue-cli/issues"
  },
  "homepage": "https://github.com/KirkPX/glue-cli#readme",
  "overrides": {
    "esbuild": "^0.28.1"
  }
}
