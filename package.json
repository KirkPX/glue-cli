{
  "name": "@kirkpx/glue-cli",
  "version": "2.2.1",
  "description": "CLI for Glue (glue.co) \u2014 threads, messages, groups, reactions, real-time watch, over the GraphQL API + GetStream chat layer",
  "main": "./dist/lib.js",
  "types": "./dist/lib.d.ts",
  "bin": {
    "glue": "./dist/index.js"
  },
  "files": [
    "dist/",
    "README.md",
    "LICENSE",
    "examples/"
  ],
  "scripts": {
    "prepare": "npm run build",
    "build": "tsup src/index.ts src/lib.ts --format esm --clean && tsc -p tsconfig.lib.json",
    "cli": "tsx src/index.ts",
    "test": "vitest run",
    "pretest": "npm run build",
    "typecheck": "tsc --noEmit",
    "dev": "tsx src/index.ts",
    "smoke": "node dist/index.js --help",
    "setup": "npm ci --engine-strict && npm link && node dist/index.js doctor --install",
    "doctor": "node dist/index.js doctor"
  },
  "keywords": [
    "glue",
    "cli",
    "chat",
    "messaging",
    "graphql",
    "getstream"
  ],
  "author": "KirkPX",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/KirkPX/glue-cli.git"
  },
  "type": "module",
  "dependencies": {
    "@apollo/client": "^4.3.7",
    "@napi-rs/keyring": "^2.1.2",
    "commander": "^15.1.0",
    "graphql": "^16.15.0",
    "picocolors": "^1.1.1",
    "stream-chat": "^9.55.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "tsup": "^9.0.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.6",
    "vitest": "^5.1.0"
  },
  "private": true,
  "exports": {
    ".": {
      "types": "./dist/lib.d.ts",
      "import": "./dist/lib.js"
    },
    "./package.json": "./package.json"
  },
  "engines": {
    "node": "^22.18.0 || ^24.11.0 || >=26.0.0"
  },
  "bugs": {
    "url": "https://github.com/KirkPX/glue-cli/issues"
  },
  "homepage": "https://github.com/KirkPX/glue-cli#readme",
  "overrides": {
    "esbuild": "^0.28.1"
  }
}
