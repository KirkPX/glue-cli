# Copy to .env for local dev, or export these in CI and automation.
# Precedence: command flags > these variables > settings file / keychain > defaults.

# Sign-in. Interactively, prefer `glue login`. These override a saved sign-in.
# GLUE_REFRESH_TOKEN=
# GLUE_ACCESS_TOKEN=
# GLUE_USER_ID=

# Refuse every command that changes data. Set to 0 to let one run write when the
# settings file says "readOnly": true.
# GLUE_READ_ONLY=1

# How long to wait for each request, in milliseconds.
# GLUE_TIMEOUT_MS=30000

# Use this settings file instead of the default one (`glue config path`).
# GLUE_CLI_CONFIG_FILE=./glue-config.json

# Pick the credential store instead of keychain-then-file. "memory" keeps tokens for
# one process only, and tests set it. "file" always uses the private credentials file.
# GLUE_CLI_CREDENTIAL_STORE=file

# Where tokens are kept when the OS keychain is closed (as over SSH on macOS).
# GLUE_CLI_CREDENTIALS_FILE=./credentials.json

# Stop `glue login` opening a browser. Tests set this.
# GLUE_NO_BROWSER=1

# Service addresses. Normally left alone. Tests point these at fake servers.
# GLUE_API_URL=https://api.gluegroups.com/graphql
# GLUE_TOKEN_URL=https://securetoken.googleapis.com/v1/token
# GLUE_AUTH_URL=https://api.gluegroups.com
# GLUE_IDENTITY_URL=https://identitytoolkit.googleapis.com/v1/accounts:signInWithCustomToken
# GLUE_STREAM_URL=

# The chat service's key, unless the settings file has it. Not built in.
# GLUE_STREAM_KEY=

# The values sign-in needs, unless the settings file has them. None is built in.
# GLUE_FIREBASE_API_KEY=
# GLUE_FIREBASE_AUTH_DOMAIN=
# GLUE_FIREBASE_PROJECT_ID=

# Read, not set: SSH_CONNECTION and SSH_TTY (login does not try a browser over SSH).
